{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "我的工作台",
  "version": "0.1.0",
  "identifier": "app.workstudio.desktop",
  "build": {
    "frontendDist": "http://127.0.0.1:18900",
    "devUrl": "http://127.0.0.1:18900"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "我的工作台",
        "width": 940,
        "height": 600,
        "minWidth": 760,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
