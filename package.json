{
  "name": "work-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vue-tsc -b && vite build",
    "typecheck": "vue-tsc -b && tsc -p tsconfig.server.json --noEmit",
    "postinstall": "node scripts/ensure-sqlite.mjs",
    "start": "tsx server/index.ts",
    "autostart:install": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/autostart.ps1 install",
    "autostart:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/autostart.ps1 uninstall",
    "autostart:run": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-workbench.ps1 -OpenBrowser",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@hono/node-server": "^1.19.11",
    "aieditor": "^1.4.2",
    "better-sqlite3": "11.10.0",
    "dotenv": "^17.2.3",
    "element-plus": "^2.14.3",
    "hono": "^4.11.9",
    "vue": "^3.5.40",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "less": "^4.4.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.0",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  },
  "packageManager": "pnpm@10.16.1",
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
